# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez jamais ".env".

# --- Base de données -------------------------------------------------------
# Par défaut : SQLite (aucune installation, fichier dans /data).
DB_DRIVER=sqlite
# Idéalement un dossier HORS de la racine web (ex. /home/utilisateur/gradis-data)
DB_PATH=

# Pour MySQL / MariaDB (hébergement cPanel) :
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_NAME=gradis
# DB_USER=gradis_user
# DB_PASS=changez-moi

# --- Application -----------------------------------------------------------
# Laissez vide pour la détection automatique du sous-dossier.
APP_BASE=
# production | development (development affiche les erreurs)
APP_ENV=production
# Charge les produits, avis et prix de DÉMONSTRATION à la première installation.
SEED_DEMO=1
